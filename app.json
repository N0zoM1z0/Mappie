{
  "expo": {
    "name": "Mappie",
    "slug": "mappie",
    "scheme": "mappie",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/mappie-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07110e",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.n0zom1z0.mappie",
      "infoPlist": {
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.n0zom1z0.mappie",
      "adaptiveIcon": {
        "backgroundColor": "#07110e",
        "foregroundImage": "./assets/mappie-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mappie uses your location to draw the paths you choose to explore.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/mappie-icon.png"
    }
  }
}
